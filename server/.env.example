# Copy this file to .env and fill in your own values. NEVER put real values in this
# file: it is committed to git. Only your private .env holds the real ones.
MONGO_URI=mongodb://127.0.0.1:27017/task-manager
PORT=5000

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Practical 9 (caching), both optional:
# How long a cached response lives, in seconds (default 60)
CACHE_TTL=60
# Set to false to switch caching OFF, for the "uncached" readings (default true)
CACHE_ENABLED=true
